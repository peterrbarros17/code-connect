# Porta da API
PORT=3000

# Segredo usado para assinar o JWT. Troque por um valor aleatório.
# Obrigatório quando NODE_ENV=production (mínimo de 32 caracteres).
JWT_SECRET=troque-por-uma-chave-aleatoria-de-32-caracteres

# Tempo de vida do access token: 30m, 1h, 7d ou um número de segundos.
JWT_EXPIRES_IN=1h

# Origem permitida no CORS. Separe várias por vírgula.
WEB_ORIGIN=http://localhost:5173

# PostgreSQL. Os valores padrão batem com o compose.yaml da raiz.
# Em produção, defina todos explicitamente.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=code_connect
DATABASE_PASSWORD=code_connect
DATABASE_NAME=code_connect
